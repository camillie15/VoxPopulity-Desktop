<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ug.project.ui.CreatePostUI"
            prefHeight="600.0" prefWidth="1000.0">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <VBox spacing="12" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label styleClass="header-label" text="Crear Nueva Publicación" />

        <VBox spacing="8">
            <Label text="Título *" style="-fx-font-weight: bold;"/>
            <TextField fx:id="titleField" promptText="Ingresa el título de tu publicación" />
        </VBox>

        <HBox spacing="12">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Comunidad" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="comunidadComboBox" promptText="Selecciona una comunidad" />
            </VBox>
            <Region />
        </HBox>

        <VBox spacing="8" VBox.vgrow="ALWAYS">
            <Label text="Contenido *" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="contentArea"
                      promptText="Escribe el contenido de tu publicación..."
                      wrapText="true"
                      prefRowCount="12" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Button onAction="#onCreatePost" text="Crear Publicación"
                    style="-fx-font-weight: bold; -fx-background-color: #2196F3; -fx-text-fill: white;"/>
            <Button onAction="#onCancel" text="Cancelar"
                    style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        </HBox>

    </VBox>

</AnchorPane>
