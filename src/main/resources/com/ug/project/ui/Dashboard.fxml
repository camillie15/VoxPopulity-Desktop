<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ug.project.controller.PostController">

    <padding>
        <Insets bottom="14" left="14" right="14" top="14" />
    </padding>

    <Label styleClass="header-label" text="Muro de Publicaciones" />

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="520" prefWidth="760">
        <content>
            <VBox fx:id="postsContainer" spacing="10">
                <padding>
                    <Insets bottom="10" left="5" right="15" top="5" />
                </padding>

            </VBox>
        </content>
    </ScrollPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button onAction="#onCreatePost" text="Nueva Publicación" />
        <Button onAction="#onRefresh" text="Recargar" />
        <Button onAction="#onBack" text="Atrás" />
    </HBox>

</VBox>