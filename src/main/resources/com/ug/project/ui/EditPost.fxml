<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ug.project.ui.EditPostUI"
      spacing="15"
      prefWidth="500"
      prefHeight="400"
      style="-fx-padding: 20;">

    <Label text="Editar Post" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="8">
        <Label text="Título:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="titleField" promptText="Ingrese el título del post"/>
    </VBox>

    <VBox spacing="8" prefHeight="200">
        <Label text="Contenido:" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="contentArea"
                  promptText="Ingrese el contenido del post"
                  wrapText="true"
                  prefRowCount="8"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancelar"
                style="-fx-background-color: #666; -fx-text-fill: white;"/>
        <Button fx:id="saveButton" text="Guardar Cambios"
                style="-fx-background-color: #44dd44; -fx-text-fill: white;"/>
    </HBox>

</VBox>