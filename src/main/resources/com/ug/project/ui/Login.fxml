<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ug.project.controller.LoginController"
           stylesheets="@style.css"
           styleClass="root-login">

    <!-- CENTRO: TARJETA DE LOGIN -->
    <VBox alignment="CENTER" spacing="15" styleClass="login-card">

        <Label text="Iniciar Sesión" styleClass="login-title"/>

        <TextField fx:id="txtUsername"
                   promptText="Usuario"
                   maxWidth="260"
                   styleClass="login-input"/>

        <PasswordField fx:id="txtPassword"
                       promptText="Contraseña"
                       maxWidth="260"
                       styleClass="login-input"/>

        <Button text="Ingresar"
                onAction="#onLogin"
                maxWidth="260"
                styleClass="login-button"/>

        <Hyperlink text="¿No tienes cuenta? Crear cuenta"
                   onAction="#onGoRegister"
                   styleClass="login-hyperlink"/>

    </VBox>

</StackPane>
