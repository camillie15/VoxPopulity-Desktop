<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ug.project.controller.CommunityController"
      spacing="12" alignment="TOP_CENTER">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <Label text="Comunidades" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <ListView fx:id="lvCommunities" prefHeight="520" prefWidth="760" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtName" promptText="Nombre" prefWidth="220" />
        <TextField fx:id="txtDescription" promptText="Descripción" prefWidth="360" />
        <Button text="Crear" onAction="#onCreate" />
        <Button text="Eliminar" onAction="#onDelete" />
        <Button text="Atrás" onAction="#onBack" />
    </HBox>

</VBox>
