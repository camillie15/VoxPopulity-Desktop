<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ug.project.controller.CommunityController"
      spacing="12" alignment="TOP_CENTER">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Comunidades" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <!-- Contenedor principal: izquierda lista, derecha formulario de creación -->
    <HBox spacing="18" alignment="TOP_CENTER">
        <!-- IZQUIERDA: listado de comunidades -->
        <ListView fx:id="lvCommunities" prefHeight="640" prefWidth="680" />

        <!-- DERECHA: formulario para crear/gestionar una comunidad -->
        <VBox spacing="8" alignment="TOP_LEFT" prefWidth="360">
            <Label text="Nueva comunidad" style="-fx-font-size: 16; -fx-font-weight: bold;" />

            <Label text="Nombre" />
            <TextField fx:id="txtName" promptText="Nombre" />

            <Label text="Descripción" />
            <TextField fx:id="txtDescription" promptText="Descripción" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Crear" onAction="#onCreate" />
                <Button text="Eliminar" onAction="#onDelete" />
            </HBox>

            <Button text="Atrás" onAction="#onBack" />
        </VBox>
    </HBox>

</VBox>
